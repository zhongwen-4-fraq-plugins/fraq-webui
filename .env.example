# fraq-webui 环境变量示例：复制为 .env 后按需填写
# .env 已在 .gitignore 中，不会被提交；服务启动时自动加载。

# 登录令牌；未设置时启动自动生成并打印在终端
FRAQ_WEBUI_TOKEN=

# 服务监听地址与端口（可选）
# FRAQ_WEBUI_HOST=127.0.0.1
# FRAQ_WEBUI_PORT=8787

# fraq 项目目录（也可在设置页修改；env 优先）
# FRAQ_WEBUI_APP_DIR=D:/bot/fraq-plugins/my-fraq-app

# 真实 Milky 协议端地址与访问令牌（可选）
# FRAQ_WEBUI_MILKY_URL=http://localhost:30001
# FRAQ_WEBUI_MILKY_TOKEN=
